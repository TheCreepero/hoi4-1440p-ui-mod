			font = "hoi_20bs"
			borderSize = {x = 0 y = 0}
			text = "TASK_FORCE_COMPOSITION_EDITOR_TITLE"
			maxWidth = 470
			maxHeight = 20
			format = center
		}

		buttonType = {
			name = "btn_close"
			position = {x=477 y=15}
			spriteType = "GFX_NV_btn_close"
			pdx_tooltip = "CLOSE"
			shortcut = "ESCAPE"
		}

		buttonType = {
			name = "btn_cancel"
			position = { x=115 y=111}
