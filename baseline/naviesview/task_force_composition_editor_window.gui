			quadTextureSprite ="GFX_button_148x34"
			buttonText = "OK"
			buttonFont = "hoi_16mbs"
			shortcut = "RETURN"
			clicksound = click_default
		}

		@buttons_height=54

		buttonType = {
			name = "btn_reset"
			spriteType = "GFX_NV_btn_reset"
			position = { x= 25 y = @buttons_height }
		}

		buttonType = {
			name = "btn_clear_template"
