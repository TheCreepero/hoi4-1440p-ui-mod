			position = { x = 220 y = 44 }
		}

		background = {
			name = "Background"
			spriteType = "GFX_tiled_window"
		}

		iconType = {
			name = "header_bg"
			spriteType = "GFX_frontend_task_force_composition_editor_upper_bar"
			position = { x=9 y=10 }
			alwaystransparent = yes
		}
