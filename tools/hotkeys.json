{
  "_comment": "Shift+M and Shift+J are reserved by HOI4 Manager Pages (the pages split out on 2026-10-21) and are not used here. The shared hotkey table (wiki/Design-Language.md, Hotkeys; user decision 2026-10-21): one key per action on every screen, and one action per key. Every hotkey the mod adds is listed here under its action as file:button; the keys vanilla gives its own buttons stay as they are and are not listed. A new hotkey reuses the key of its action, or adds an action with a free shift+letter. tests/ScreenInvariants.Tests.ps1 checks the files against this table.",
  "always": {"ESCAPE": "Close the window", "RETURN": "Confirm"},
  "actions": [
    {"action": "Create a new group from the selection", "key": "shift+n", "buttons": ["zz_1440p_air_selection.gui:btn_create_air_group", "zz_1440p_fleet.gui:btn_create_new_from_selected"]},
    {"action": "Unassign from the commander", "key": "shift+u", "buttons": ["zz_1440p_air_selection.gui:btn_unassign", "zz_1440p_army_selection.gui:btn_unassign"]},
    {"action": "Consolidate the selection", "key": "shift+c", "buttons": ["zz_1440p_army_selection.gui:btn_consolidate_selection"]},
    {"action": "Upgrade", "key": "shift+g", "buttons": ["zz_1440p_fleet.gui:btn_upgrade"]},
    {"action": "Repair now", "key": "shift+p", "buttons": ["zz_1440p_fleet.gui:btn_repair_now"]},
    {"action": "Set as reserve", "key": "shift+r", "buttons": ["zz_1440p_fleet.gui:btn_exclude"]},
    {"action": "Sort into task forces automatically", "key": "shift+o", "buttons": ["zz_1440p_fleet.gui:btn_taskforce_o_matic"]},
    {"action": "Open the details", "key": "shift+i", "buttons": ["zz_1440p_army_overview.gui:details_open"]},
    {"action": "Open the losses", "key": "shift+l", "buttons": ["zz_1440p_army_overview.gui:destroyed_ships_open"]},
    {"action": "Show the decommissioned templates", "key": "shift+v", "buttons": ["zz_1440p_recruit_deploy.gui:checkbox"]},
    {"action": "Open the designer", "key": "shift+f", "buttons": ["zz_1440p_recruit_deploy.gui:open_designer_button"]},
    {"action": "Tab: statistics", "key": "shift+a", "buttons": ["zz_1440p_unit_details.gui:stats_tab_button", "zz_1440p_unit_details.gui:tab_stats"]},
    {"action": "Tab: template", "key": "shift+t", "buttons": ["zz_1440p_unit_details.gui:template_tab_button"]},
    {"action": "Tab: history", "key": "shift+h", "buttons": ["zz_1440p_unit_details.gui:history_tab_button", "zz_1440p_unit_details.gui:tab_history"]},
    {"action": "Promote", "key": "shift+z", "buttons": ["zz_1440p_unit_details.gui:promote_officer", "zz_1440p_unit_details.gui:promote_captain"]}
  ]
