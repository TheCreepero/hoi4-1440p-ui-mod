# Screen 'theatre_bar', reworked for 2560x1440.
# Overrides single top-level windows of the vanilla interface files; the vanilla files stay in place and
# supply every other window. The untouched vanilla text of each window is in baseline/.
#
# A8 redesign (2026-10-16): every box is a card of 424x86 drawn over its 420x88 window at x 310, so the
# right edge stays at screen x 2530 (fix round 1: 8 px taller, so the 28 px chips at y 9 sit inside the
# grey of the title plate). A card has a title plate (y 4-44, grey 8-37) and a units band (y 46-81) in its
# texture (GFX_1440p_TS_card, tools/stretch_background.py), and a 6 px stripe down its left side in the
# colour of the frame the code gives. The chips behind the battle widgets, the counts and the priorities
# are mod1440_ts_* icons drawn behind widgets that stay where the code looks for them; they let every
# click through (alwaystransparent). The rows under a box are drawers of the same width.
guiTypes = {
	# Windows from vanilla interface/theatreselector.gui
	containerWindowType = {
		name = "theater_group_item"
		position = { x=310 y=15 }
		size = { width=420 height=88 }

		iconType = {
			name ="background"
			quadTextureSprite = "GFX_1440p_TS_card"
			position = { x = 0 y = 0 }
