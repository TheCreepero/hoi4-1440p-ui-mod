# Screen 'army_selection', reworked for 2560x1440.
# Overrides single top-level windows of the vanilla interface files; the vanilla files stay in place and
# supply every other window. The untouched vanilla text of each window is in baseline/.
guiTypes = {
	# Windows from vanilla interface/unitview.gui
	containerWindowType = {
		name = "army_division_list_view"
		position = {x=1 y=2}
		size = { width=670 height=760 } # height set in code, but initial value here is used for max allowed height when not stretched to full screen height
		Orientation = upper_left
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite ="GFX_tiled_window_1b_thin_border"
		}

		# Off-screen anchor for the ctrl+g+s shortcut. containerWindowType cannot host shortcut=,
		# so a hidden buttonType is the only place the engine will dispatch the chord from.
		buttonType = {
			name = "select_hq_shortcut_anchor"
			position = { x=-1000 y=-1000 }
			quadTextureSprite = "GFX_group_marker3"
			shortcut = "ctrl+g+s"
		}

		containerWindowType = {
			name = "content_window"
			position = {x=0 y=0}
			margin = { top = 8 }
			size = {width=670 height=1} # Y Set in code to match the window size
			Orientation = upper_left
			clipping = no

			iconType = {
				name = "army_group_header"
				spriteType = "GFX_1440p_UV_unit_list_header"
				position = { x = 7 y = 0 }
			}

			buttonType = {
				name = "btn_delete"
				position = { x=9 y=0 }
				spriteType = "GFX_NV_btn_delete"
				clicksound = disband
			}

			dropDownBoxType = {
				name = "divisions"
				position = { x = 37 y = 2 }
				size = { width = 200 height = 30 }
				#clipping = no

				expandButton = {
					name = "expand_button"
					position = { x = 0 y = -2 }
					spriteType = "GFX_change_template_button"
					clicksound = click_default
				}

				expandedWindow = {
					name = "expanded_window"
					position = { x=0 y= -600 }
					show_position = { x = 0 y = 18 }
					show_animation_type = decelerated
					hide_animation_type = accelerated
					animation_time = 300
					size = { width=382 height=615 }	
					verticalScrollbar = "right_vertical_slider"
					scroll_wheel_factor = 50
					smooth_scrolling = yes
					margin = { top = 7 bottom = 7 right = 6 }
					#clipping = no

					background = {
						name = "Background"
						quadTextureSprite ="GFX_tiled_window_1b_thin_border"
						position = { x = 0 y = 0 }
					}

					gridBoxType = {
						name = "divisions_grid"
						position = { x = 8 y = 0 }
						size = { width = 351 height = 100%% }
						slotsize = { width = 350 height = 50 }
						max_slots_horizontal = 1
						format = "UPPER_LEFT"
					}
				}
			}

			instantTextboxType = {
				name = "selected_division_count"
				position = {x=75 y=5}
