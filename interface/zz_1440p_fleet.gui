# Screen 'fleet', reworked for 2560x1440.
# Overrides single top-level windows of the vanilla interface files; the vanilla files stay in place and
# supply every other window. The untouched vanilla text of each window is in baseline/.
guiTypes = {
	# Windows from vanilla interface/naviesview.gui
	containerWindowType = {
		name = "naviesview_window"
		position = {x=-340 y=82}
		show_position = {x=0 y=82}
		size = { width=748 height=86%% }
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300
		Orientation = upper_left
		clipping = no

		background = {
			name = "Background"
			spriteType = "GFX_tiled_window_transparent"
			alwaystransparent = yes
		}


		# Fleet detailed list (visibility toggled by code)
		containerWindowType = {
			name = "detailed_fleet_list"
