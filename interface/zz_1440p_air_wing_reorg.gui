# Screen 'air_wing_reorg', reworked for 2560x1440.
# Overrides single top-level windows of the vanilla interface files; the vanilla files stay in place and
# supply every other window. The untouched vanilla text of each window is in baseline/.
guiTypes = {
	# Windows from vanilla interface/airwingreorganization.gui
	containerWindowType = {
		name = "air_wing_reorganization"
		position = { x=-620 y=-590 }
		size = { width =1240 height=1180 }
		orientation= center
		moveable = yes
		fade_time = 200
		fade_type = linear
		clipping = no

		background = {
			name = "Background"	
			quadTextureSprite ="GFX_tiled_plain_bg"
		}

		# The mod's plates, drawn behind widgets that stay children of this window (A9 method): the
		# title strip, a header strip per column (Reserves | Reinforcements) and the footer strip.
		iconType = {
			name = "mod1440_aw_title"
			spriteType = "GFX_1440p_AW_title"
			position = { x = 6 y = 6 }
			alwaystransparent = yes
		}
