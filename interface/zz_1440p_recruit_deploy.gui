# Screen 'recruit_deploy', reworked for 2560x1440.
# Overrides single top-level windows of the vanilla interface files; the vanilla files stay in place and
# supply every other window. The untouched vanilla text of each window is in baseline/.
guiTypes = {
	# Windows from vanilla interface/countrydeploymentview.gui
	containerWindowType = {
		name = "countrydeploymentview"
		position = { x=-606 y=78 }
		show_position = { x=-6 y =78 }
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300
		size = { width=640 height=100%% }
		# lets the Army Readiness page, a scripted GUI attached to this tab, show beside the two panels
		# (wiki/Engine-Facts.md, X6)
		clipping = no

		#hide_sound = menu_close_window
		show_sound = menu_open_window

		background = {
			name = "Background"
			quadTextureSprite ="GFX_tiled_window"
		}

		iconType ={
			name ="production_header_bg"
