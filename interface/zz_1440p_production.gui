# Screen 'production', reworked for 2560x1440.
# Overrides single top-level windows of the vanilla interface files; the vanilla files stay in place and
# supply every other window. The untouched vanilla text of each window is in baseline/.
@prod_icon_pos_x = 620
@prod_sub_pos_x = 648
@prod_add_pos_x = 714
@prod_nof_pos_x = 674
guiTypes = {
	# Windows from vanilla interface/countryproductionlineview.gui
	containerWindowType = {
		name = "countryproductionlineview"
		position = { x=-876 y=78}
